PORT=3000
APP_PASSWORD=change-me

# Shopify (Custom app -> Admin API access token, scopes: write_products)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=shpat_xxx

# Claude (description generation)
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-5-5

# ERP / system API (see src/erp.js). {q} / {code} are replaced in the URLs.
ERP_SEARCH_URL=https://erp.example.com/api/products?search={q}
ERP_UPDATE_URL=https://erp.example.com/api/products/{code}
ERP_UPDATE_METHOD=PUT
ERP_AUTH_HEADER=Authorization: Bearer xxx
# Field names in the ERP JSON (dot paths ok). List path: ERP_LIST_PATH (empty = root array)
ERP_LIST_PATH=data
ERP_CODE_FIELD=code
ERP_NAME_FIELD=name


# Frame: assets/frame.png + assets/frame.json (photo window + code position). Rebuild with: node assets/frames/build-mekanezm.js
